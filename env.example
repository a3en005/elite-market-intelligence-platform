# Copy this file to .env.development.local (dev) or configure these in your
# hosting provider's environment settings (production). Never commit real secrets.

# --- Server-side secrets (never exposed to the browser) ---
OANDA_API_KEY=your-oanda-api-key
OANDA_ACCOUNT_ID=your-oanda-account-id
OANDA_ENV=practice
BINANCE_API_KEY=your-binance-api-key
GEMINI_API_KEY=your-gemini-api-key

# --- Client-side public config (safe to expose, prefixed with VITE_) ---
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
